PORT=3000

# 本 API 對外網址（組藍新 NotifyURL/ReturnURL 用），本機開發留空或填 http://localhost:3000 即可
API_BASE_URL=http://localhost:3000

# Supabase：先跑 `supabase start`（見 README quick start），終端機印出的
# API URL / service_role key 貼在這裡即可，不用自己申請雲端專案
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket 名稱（商品/廣告圖片上傳用），本機 stack 預設就有 demo-uploads
SUPABASE_STORAGE_BUCKET=demo-uploads

# JWT：本機自己產生一組，不要用預設值。產生方式：
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# App
NODE_ENV=development

# 正式環境允許的前端來源，逗號分隔（可用 * 當萬用字元），例如：
# CORS_ALLOWED_ORIGINS=https://my-frontend.vercel.app,https://my-dashboard.vercel.app
# 本機開發不用填，localhost/ngrok/區網 IP 已經內建允許
CORS_ALLOWED_ORIGINS=

# SMS Provider: twilio | mitake | (留空 = 只印 console，開發用，不用申請任何帳號)
SMS_PROVIDER=

# Twilio (SMS_PROVIDER=twilio 時填入)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# MITAKE 三竹 (SMS_PROVIDER=mitake 時填入)
MITAKE_USERNAME=
MITAKE_PASSWORD=

# LINE Bot（留空 = 功能自動關閉，不影響其他功能）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_BOT_BASIC_ID=

# Email OTP 通知（留空 = 不寄信，OTP 一樣會印在 server console）
# SMTP_USER 填寄件 Gmail，SMTP_PASS 填 App Password
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# LINE Login（與 LINE Bot 是不同 Channel，留空 = 功能自動關閉）
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=https://你的前端網址/auth/line/callback

# Star CloudPRNT 出單機（填入要觸發列印的 store_id；留空 = 不啟用，不影響其他功能）
CLOUDPRNT_STORE_ID=
# CloudPRNT Basic Auth（設定後印表機要填相同帳密；留空 = 不驗證）
CLOUDPRNT_USER=
CLOUDPRNT_PASS=

# 藍新 NewebPay（留空 = 直接跳過線上刷卡，demo 商店預設就是關閉這個功能，
# 不影響現金/LINE Pay 等其他付款方式的結帳流程）
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
NEWEBPAY_API_URL=https://ccore.newebpay.com/MPG/mpg_gateway   # 測試環境
# NEWEBPAY_API_URL=https://core.newebpay.com/MPG/mpg_gateway  # 正式環境
NEWEBPAY_REFUND_API_URL=https://ccore.newebpay.com/API/CreditCard/Close   # 測試環境
# NEWEBPAY_REFUND_API_URL=https://core.newebpay.com/API/CreditCard/Close  # 正式環境
NEWEBPAY_CANCEL_API_URL=https://ccore.newebpay.com/API/CreditCard/Cancel   # 測試環境
# NEWEBPAY_CANCEL_API_URL=https://core.newebpay.com/API/CreditCard/Cancel  # 正式環境

# 商家自訂藍新帳號（custom 模式）的 HashKey/HashIV 存進資料庫前會用這把金鑰加密
# （AES-256-GCM），32 bytes 的隨機值、base64 編碼。產生方式：
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=

# 平台管理後台的 Google 登入（留空 = 平台層端點跑不起來，但程式碼一樣看得到；
# 只有想真的點過 /api/platform/* 才需要設定）
# Google Cloud Console 建立的 OAuth 2.0 用戶端 ID
GOOGLE_CLIENT_ID=
# 允許登入平台管理後台的 Google 帳號，逗號分隔
PLATFORM_ALLOWED_EMAILS=
# 平台層 session token 簽發用，跟商家用的 JWT_SECRET 分開。產生方式：
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
PLATFORM_JWT_SECRET=
